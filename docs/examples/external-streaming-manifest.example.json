{
  "name": "Beacon Sunshine-compatible wrapper",
  "protocol": "gamestream",
  "launchUri": "moonlight://beacon/session",
  "endpoints": {
    "input": "udp://127.0.0.1:48000",
    "rtsp": "rtsp://127.0.0.1:48010/beacon"
  },
  "codecs": [
    "av1",
    "hevc",
    "h264"
  ],
  "maxFps": 120,
  "maxBitrateMbps": 150,
  "hdr10": true,
  "transports": [
    "lan-direct"
  ],
  "encoders": [
    "nvenc",
    "amf",
    "qsv"
  ],
  "capture": [
    "dxgi",
    "windows-graphics-capture"
  ],
  "diagnostics": [
    "ready"
  ]
}
