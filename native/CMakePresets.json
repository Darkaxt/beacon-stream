{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "cacheVariables": {
        "BEACON_WITH_MSQUIC": "ON",
        "BEACON_PROTOC_EXECUTABLE": "$env{BEACON_PROTOC_EXECUTABLE}",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 hosted validation",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/beacon/build/linux-x64-debug",
      "cacheVariables": {
        "BEACON_NATIVE_DEPENDENCIES_DIR": "$env{HOME}/.cache/beacon/native/_deps",
        "BEACON_PROTOC_EXECUTABLE": "$env{BEACON_PROTOC_EXECUTABLE}",
        "BEACON_WITH_MSQUIC": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "$env{HOME}/.cache/beacon/build/${presetName}",
      "toolchainFile": "$env{BEACON_ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-29",
        "BEACON_NATIVE_DEPENDENCIES_DIR": "$env{HOME}/.cache/beacon/native/_deps",
        "BEACON_PROTOC_EXECUTABLE": "$env{BEACON_PROTOC_EXECUTABLE}",
        "BEACON_WITH_MSQUIC": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android emulator x86_64",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android physical arm64",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64"
    },
    {
      "name": "android-x86_64-debug",
      "configurePreset": "android-x86_64"
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
