<Window x:Class="Beacon.Cockpit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacon Cockpit"
        Width="1040"
        Height="680"
        MinWidth="840"
        MinHeight="520"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Server" Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding ServerUrl}"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0" />
                <Button Grid.Column="2"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}" />
                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Clients" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding ClientCount}" Style="{StaticResource MetricText}" />

                    <TextBlock Text="Sessions" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding SessionCount}" Style="{StaticResource MetricText}" />

                    <TextBlock Text="Streams" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding StreamCount}" Style="{StaticResource MetricText}" />

                    <TextBlock Text="Ownership" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding OwnershipCount}" Style="{StaticResource MetricText}" />

                    <TextBlock Text="Games" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding GameCount}" Style="{StaticResource MetricText}" />

                    <TextBlock Text="Display" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding DisplayHealthSummary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <Separator Margin="0,8,0,14" />

                    <TextBlock Text="Selected Client" Style="{StaticResource LabelText}" />
                    <ComboBox ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              MinHeight="30"
                              Margin="0,0,0,12" />

                    <Button Content="Restore Physical Display"
                            Command="{Binding RestorePhysicalCommand}"
                            Margin="0,0,0,8" />
                    <Button Content="Reset Topology"
                            Command="{Binding ResetTopologyCommand}"
                            Margin="0,0,0,8" />
                    <Button Content="Recover Client Display"
                            Command="{Binding RecoverSelectedClientCommand}"
                            Margin="0,0,0,8" />
                    <Button Content="Remove Display Lease"
                            Command="{Binding RemoveSelectedClientDisplayLeaseCommand}"
                            Margin="0,0,0,8" />
                    <Button Content="Stop Stream"
                            Command="{Binding StopSelectedClientStreamCommand}"
                            Margin="0" />
                </StackPanel>
            </Border>

            <TabControl Grid.Column="2">
                <TabItem Header="Clients">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Clients" Grid.Column="0">
                            <ListBox ItemsSource="{Binding Clients}" />
                        </GroupBox>
                        <GroupBox Header="Selected Profile" Grid.Column="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName}" IsReadOnly="True" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProfilePreferredWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Height" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProfilePreferredHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Refresh Hz" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProfilePreferredRefreshHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="HDR" Style="{StaticResource LabelText}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding ProfileHdrPreference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Off" />
                                        <ComboBoxItem Content="Prefer" />
                                        <ComboBoxItem Content="Require" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Display Mode" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProfileMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <CheckBox Grid.Row="6" Grid.Column="1" Content="Restore physical display on end" IsChecked="{Binding ProfileRestorePhysicalDisplayOnEnd, Mode=TwoWay}" Margin="0,0,0,8" />

                                    <CheckBox Grid.Row="7" Grid.Column="1" Content="Forbid mirror mode" IsChecked="{Binding ProfileForbidMirrorMode, Mode=TwoWay}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Codec" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ProfileCodecPreference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Quality" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ProfileQualityMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Bitrate Cap Mbps" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ProfileBitrateCapMbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Audio" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ProfileAudioMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <CheckBox Grid.Row="12" Grid.Column="1" Content="Keep app running on disconnect" IsChecked="{Binding ProfileKeepAppRunningOnDisconnect, Mode=TwoWay}" Margin="0,0,0,8" />

                                    <CheckBox Grid.Row="13" Grid.Column="1" Content="Allow emergency restore from client" IsChecked="{Binding ProfileAllowEmergencyRestoreFromClient, Mode=TwoWay}" Margin="0,0,0,12" />

                                    <Button Grid.Row="14" Grid.Column="1" Content="Save Profile" Command="{Binding SaveSelectedClientProfileCommand}" HorizontalAlignment="Left" />
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Streams">
                    <Grid Margin="10">
                        <ListBox ItemsSource="{Binding Streams}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Ownership">
                    <Grid Margin="10">
                        <ListBox ItemsSource="{Binding Ownership}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Games">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Catalog" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="1" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,16">
                            <Run Text="{Binding GameCount}" />
                            <Run Text=" games" />
                        </TextBlock>
                        <GroupBox Grid.Row="2" Header="Provider Diagnostics">
                            <ListBox ItemsSource="{Binding Diagnostics}" />
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Recovery">
                    <StackPanel Margin="10" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Client" Style="{StaticResource LabelText}" />
                        <ComboBox ItemsSource="{Binding Clients}"
                                  SelectedItem="{Binding SelectedClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MinWidth="280"
                                  MinHeight="30"
                                  Margin="0,0,0,14" />
                        <Button Content="Restore Physical Display"
                                Command="{Binding RestorePhysicalCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Reset Topology"
                                Command="{Binding ResetTopologyCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Recover Selected Client Display"
                                Command="{Binding RecoverSelectedClientCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Remove Selected Display Lease"
                                Command="{Binding RemoveSelectedClientDisplayLeaseCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Stop Selected Stream"
                                Command="{Binding StopSelectedClientStreamCommand}"
                                Margin="0,0,0,8" />
                        <Separator Margin="0,6,0,14" />
                        <Button Content="Move All Back Minimized"
                                Command="{Binding MoveWindowsBackCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Close Virtual Windows"
                                Command="{Binding CloseVirtualWindowsCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Terminate Virtual Processes"
                                Command="{Binding TerminateVirtualProcessesCommand}"
                                Margin="0" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Diagnostics">
                    <Grid Margin="10">
                        <ListBox ItemsSource="{Binding Diagnostics}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
